#include <behaviors.dtsi>
// #include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#include <dt-bindings/zmk/pointing.h>

// Keys
#define LEFT_HALF   0  1  2  3  4  5 12 13 14 15 16 17 24 25 26 27 28 29
#define RIGHT_HALF  6  7  8  9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define THUMBS     36 37 38 39 40

// Layers
#define ENG 0 // Alpha LAT 
#define RUL 1 // Alpha RUS
#define QWE 2 // QWERTY (static)
#define EXT 3 // Extended Symbols
#define NAV 4 // Navigation
#define FUN 5 // Function
#define MYS 6 // Mice

#define A_RU F
#define B_RU COMMA
#define C_RU W
#define D_RU L
#define E_RU T
#define F_RU A
#define G_RU U
#define H_RU LBKT
#define I_RU B
#define J_RU Q    // ij
#define K_RU R
#define L_RU K
#define M_RU V
#define N_RU Y
#define O_RU J
#define P_RU G
#define Q_RU DOT  // yu
#define R_RU H
#define S_RU C
#define T_RU N
#define U_RU E
#define V_RU SEMI // zh
#define W_RU D
#define X_RU Z    // ya
#define Y_RU S
#define Z_RU P

#define CH_RU   X
#define SH_RU   I
#define SCH_RU  O
#define SOFT_RU M
#define HARD_RU RBKT
#define JO_RU   GRAVE
#define JE_RU   SQT

#define COMMA_K_RU LS(FSLH)
#define SEMI_K_RU  LS(N4)
#define DOT_K_RU   FSLH
#define COLON_K_RU LS(N6)

// Bindings
#define _____ &none

#define TAPPING_TERM    500  // tapping-term-ms = <300>;
#define QUICK_TAP_TERM  250  // tapping-term-ms = <300>;
#define COMBO_TIMEOUT_2  50  // timeout-ms for 2 fingers cofbos
#define COMBO_TIMEOUT_3  80  // timeout-ms for 3 fingers combos

#define hrlG(key) &lgui_en 0 key
#define hrrG(KEY) &rgui_en 0 KEY
#define hrlC(KEY) &lctl_en 0 KEY
#define hrrC(KEY) &rctl_en 0 KEY
#define hrlS(key) &lshft 0 key
#define hrrS(key) &rshft 0 key
#define hrlA(KEY) &lalt_en 0 KEY
#define hrrA(KEY) &ralt_en 0 KEY

#define hrlG_RU(key) &lgui_ru 0 key // mods temporary toggled layer to ALPHA_LAT
#define hrrG_RU(KEY) &rgui_ru 0 KEY // mods temporary toggled layer to ALPHA_LAT
#define hrlC_RU(KEY) &lctl_ru 0 KEY // mods temporary toggled layer to ALPHA_LAT
#define hrrC_RU(KEY) &rctl_ru 0 KEY // mods temporary toggled layer to ALPHA_LAT
#define hrlA_RU(KEY) &lalt_ru 0 KEY // mods temporary toggled layer to ALPHA_LAT
#define hrrA_RU(KEY) &ralt_ru 0 KEY // mods temporary toggled layer to ALPHA_LAT

#define THUMBS_ROW _____ &lt NAV SPC &mo QWE &f20 _____

#define ALPHA(NAME, \
 T1, T2, T3, T4, T5, T6, T7, T8, T9, T10, \
 M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, \
 B1, B2, B3, B4, B5, B6, B7, B8, B9, B10) \
NAME { bindings = < \
_____ &kp T1   hrlC(T2)     hrlA(T3)     hrlG(T4)     &kp T5      &kp T6  hrrG(T7)     hrrA(T8)     hrrC(T9)     &kp T10    _____ \
_____ hrlS(M1) &mol EXT M2  &mol FUN M3  &mol MYS M4  &kp M5      &kp M6  &kp M7       &mor FUN M8  &mor EXT M9  hrrS(M10)  _____ \
_____ &kp B1   &kp B2       &kp B3       &kp B4       &kp B5      &kp B6  &kp B7       &B8          &B9          &kp B10    _____ \
                                                           THUMBS_ROW \
>;};

#define ALPHA_RU(NAME, \
 T1, T2, T3, T4, T5, T6, T7, T8, T9, T10, \
 M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, \
 B1, B2, B3, B4, B5, B6, B7, B8, B9, B10) \
NAME { bindings = < \
_____ &kp T1##_RU   hrlC_RU(T2##_RU)  hrlA_RU(T3##_RU)  hrlG_RU(T4##_RU)  &kp T5##_RU      &kp T6##_RU  hrrG_RU(T7##_RU)  hrrA_RU(T8##_RU)  hrrC_RU(T9##_RU)  &kp T10##_RU    _____ \
_____ hrlS(M1##_RU) &mol EXT M2##_RU  &mol FUN M3##_RU  &mol MYS M4##_RU  &kp M5##_RU      &kp M6##_RU  &kp M7##_RU       &mor FUN M8##_RU  &mor EXT M9##_RU  hrrS(M10##_RU)  _____ \
_____ &kp B1##_RU   &kp B2##_RU       &kp B3##_RU       &kp B4##_RU       &kp B5##_RU      &kp B6##_RU  &kp B7##_RU       &B8##_RU          &B9##_RU          &kp B10##_RU    _____ \
                                                           THUMBS_ROW \
>;};

#define MOD_MACRO(name, mod)                            \
name: name##_macro {                                    \
    compatible = "zmk,behavior-macro";              \
    #binding-cells = <0>;                           \
    wait-ms = <0>;                                  \
    bindings                                            \
        = <&macro_press &kp mod>                        \
        , <&macro_pause_for_release>                    \
        , <&macro_release &kp mod>;                     \
 };
#define LAT_MOD_MACRO(name, mod, base_layer, mod_layer) \
name: name##_macro {                                    \
    compatible = "zmk,behavior-macro";              \
    #binding-cells = <0>;                           \
    wait-ms = <0>;                                  \
    bindings                                            \
        = <&macro_press &kp mod>                        \
        , <&macro_tap &to mod_layer>                    \
        , <&macro_pause_for_release>                    \
        , <&macro_tap &to base_layer>                   \
        , <&macro_release &kp mod>;                     \
 };
#define HOME_ROW_MOD_TAP_LEFT(name, macro, flavortype)  \
name: name##_mod_tap_lefthand {                         \
    compatible = "zmk,behavior-hold-tap";               \
    #binding-cells = <2>;                               \
    flavor = #flavortype;                               \
    tapping-term-ms = <TAPPING_TERM>;                   \
    quick-tap-ms = <QUICK_TAP_TERM>;                    \
    bindings = <macro>, <&kp>;                          \
    hold-trigger-key-positions = < RIGHT_HALF THUMBS >; \
};
#define HOME_ROW_MOD_TAP_RIGHT(name, macro, flavortype) \
name: name##_mod_tap_righthand {                        \
    compatible = "zmk,behavior-hold-tap";               \
    #binding-cells = <2>;                               \
    flavor = #flavortype;                               \
    tapping-term-ms = <TAPPING_TERM>;                   \
    quick-tap-ms = <QUICK_TAP_TERM>;                    \
    bindings = <macro>, <&kp>;                          \
    hold-trigger-key-positions = < LEFT_HALF THUMBS >;  \
};

&sk {
    release-after-ms = <1500>;
    quick-release;
};
&lt {
    tapping-term-ms = <500>;
    quick-tap-ms = <200>;
    flavor = "balanced";
 };
&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
    flavor = "balanced";
 };

/ {
combos { compatible = "zmk,combos";
    lock         { bindings = <&kp LC(LG(Q))>; key-positions = < 2 3 4 >; timeout-ms = < COMBO_TIMEOUT_3 >; };

    escape_left  { bindings = <&kp ESC>; key-positions = <2 3>; timeout-ms = < COMBO_TIMEOUT_2 >; };
    escape_left2 { bindings = <&kp ESC>; key-positions = <2 14>; timeout-ms = < COMBO_TIMEOUT_2 >; };
    escape_right { bindings = <&kp ESC>; key-positions = <8 9>; timeout-ms = < COMBO_TIMEOUT_2 >; };
    escape_right2{ bindings = <&kp ESC>; key-positions = <9 21>; timeout-ms = < COMBO_TIMEOUT_2 >; };

    enter_left   { bindings = <&kp ENTER>; key-positions = <4 16>; timeout-ms = < COMBO_TIMEOUT_2 >; };
    enter_right  { bindings = <&kp ENTER>; key-positions = <32 33>; timeout-ms = < COMBO_TIMEOUT_2 >; };
    enter_right2 { bindings = <&kp ENTER>; key-positions = <7  19>; timeout-ms = < COMBO_TIMEOUT_2 >; };

    bspc_left    { bindings = <&kp BACKSPACE>; key-positions = <3 16>; timeout-ms = < COMBO_TIMEOUT_2 >; };
    bspc_right   { bindings = <&kp BACKSPACE>; key-positions = <8 19>; timeout-ms = < COMBO_TIMEOUT_2 >; };
    
    del_left     { bindings = <&kp DELETE>; key-positions = <3 14>; timeout-ms = < COMBO_TIMEOUT_2 >; };
    del_right    { bindings = <&kp DELETE>; key-positions = <8 21>; timeout-ms = < COMBO_TIMEOUT_2 >; };

    tab_left     { bindings = <&kp TAB>; key-positions = <3 4>; timeout-ms = < COMBO_TIMEOUT_2 >; };
    tab_right    { bindings = <&kp TAB>; key-positions = <7 8>; timeout-ms = < COMBO_TIMEOUT_2 >; };
    tab_left_2   { bindings = <&kp TAB>; key-positions = <3 15>; timeout-ms = < COMBO_TIMEOUT_2 >; };
    tab_right_2  { bindings = <&kp TAB>; key-positions = <8 20>; timeout-ms = < COMBO_TIMEOUT_2 >; };

    copy_cut     { bindings = <&td_copy_cut>; key-positions = < 14 16 >; timeout-ms = < COMBO_TIMEOUT_2 >; };
    paste        { bindings = <&kp LG(V)>; key-positions = < 2 4 >; timeout-ms = < COMBO_TIMEOUT_2 >; };
    undo         { bindings = <&kp LG(Z)>; key-positions = < 13 16 >; timeout-ms = < COMBO_TIMEOUT_2 >; };
    redo         { bindings = <&kp LS(LG(Z))>; key-positions = < 1 4 >; timeout-ms = < COMBO_TIMEOUT_2 >; };

    to_rus       { bindings = <&rus>; key-positions = < 19 20 21 >; timeout-ms = < COMBO_TIMEOUT_3 >; };
    to_eng       { bindings = <&eng>; key-positions = < 14 15 16 >; timeout-ms = < COMBO_TIMEOUT_3 >; };

 };

macros {
    eng: eng { compatible = "zmk,behavior-macro";  #binding-cells = <0>; bindings = < &kp F18 &to 0 >; };
    rus: rus { compatible = "zmk,behavior-macro";  #binding-cells = <0>; bindings = < &kp F19 &to 1 >; };
    semi: semi { compatible = "zmk,behavior-macro"; tap-ms = <1>; wait-ms = <1>;  #binding-cells = <0>; bindings = < &kt_off LSHFT &kt_off RSHFT &kp SEMI >; };
    f20: f20 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
        bindings =
            <&macro_press &mo QWE &kp F20 >,
            <&macro_pause_for_release>,
            <&macro_release &kp F20 &mo QWE >;
        };
    MOD_MACRO(alt_en, LALT)
    MOD_MACRO(gui_en, LGUI)
    MOD_MACRO(ctl_en, LCTRL)
    MOD_MACRO(shft,  LSHFT)
    LAT_MOD_MACRO(alt_ru, LALT, 1, 0) // mods temporary toggled layer to ALPHA_LAT
    LAT_MOD_MACRO(gui_ru, LGUI, 1, 0) // mods temporary toggled layer to ALPHA_LAT
    LAT_MOD_MACRO(ctl_ru, LCTRL, 1, 0) // mods temporary toggled layer to ALPHA_LAT

};

behaviors {
    HOME_ROW_MOD_TAP_LEFT (lalt_en, &alt_en, balanced)
    HOME_ROW_MOD_TAP_LEFT (lgui_en, &gui_en, balanced)
    HOME_ROW_MOD_TAP_LEFT (lctl_en, &ctl_en, balanced)
    HOME_ROW_MOD_TAP_RIGHT(ralt_en, &alt_en, balanced)
    HOME_ROW_MOD_TAP_RIGHT(rgui_en, &gui_en, balanced)
    HOME_ROW_MOD_TAP_RIGHT(rctl_en, &ctl_en, balanced)

    HOME_ROW_MOD_TAP_LEFT (lalt_ru, &alt_ru, balanced) // mods temporary toggled layer to ALPHA_LAT
    HOME_ROW_MOD_TAP_LEFT (lgui_ru, &gui_ru, balanced) // mods temporary toggled layer to ALPHA_LAT
    HOME_ROW_MOD_TAP_LEFT (lctl_ru, &ctl_ru, balanced) // mods temporary toggled layer to ALPHA_LAT
    HOME_ROW_MOD_TAP_RIGHT(ralt_ru, &alt_ru, balanced) // mods temporary toggled layer to ALPHA_LAT
    HOME_ROW_MOD_TAP_RIGHT(rgui_ru, &gui_ru, balanced) // mods temporary toggled layer to ALPHA_LAT
    HOME_ROW_MOD_TAP_RIGHT(rctl_ru, &ctl_ru, balanced) // mods temporary toggled layer to ALPHA_LAT

    HOME_ROW_MOD_TAP_LEFT(lshft, &shft, balanced)
    HOME_ROW_MOD_TAP_RIGHT(rshft, &shft, balanced)

    mol: homerow_layers_left {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        tapping-term-ms = < TAPPING_TERM >;
        quick-tap-ms = < QUICK_TAP_TERM >;
        // flavor = "tap-preferred";
        flavor = "balanced";
        bindings = <&mo>, <&kp>;
        hold-trigger-key-positions = < RIGHT_HALF THUMBS >;    // <---[[right-hand keys]]
    };
    mor: homerow_layers_right {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        tapping-term-ms = < TAPPING_TERM >;
        quick-tap-ms = < QUICK_TAP_TERM >;
        // flavor = "tap-preferred";
        flavor = "balanced";
        bindings = <&mo>, <&kp>;
        hold-trigger-key-positions = < LEFT_HALF THUMBS >;    // <---[[left-hand keys]]
    };

    kt_off: key_toggle_on_only {
        compatible = "zmk,behavior-key-toggle";
        #binding-cells = <1>;
        display-name = "Key Toggle Off";
        toggle-mode = "off";
    };

    td_copy_cut: tap_dance_copy_cut {
        compatible = "zmk,behavior-tap-dance";
        #binding-cells = <0>;
        tapping-term-ms = <300>;
        bindings = <&kp LG(C)>, <&kp LG(X)>;
    };

    rt: rt {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "balanced";
        tapping-term-ms = < TAPPING_TERM >;
        quick-tap-ms = <200>;
        bindings = <&kp>, <&kp>;
        retro-tap;
    };

    comma: comma_semi {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp COMMA>, <&semi>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
        keep-mods = < 0 >;
    };
    dot: dot_colon {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp DOT>, <&kp COLON>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    qmark: qmark_excl {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp QMARK>, <&kp EXCL>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    comma_RU: comma_semi_ru {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp COMMA_K_RU>, <&kp SEMI_K_RU>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
        keep-mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    dot_RU: dot_colon_ru {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp DOT_K_RU>, <&kp COLON_K_RU>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
        keep-mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    semi_ru: semi_colon_ru {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp LS(N4)>, <&kp N6>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
        keep-mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    sqt_ru: sqt_ru {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp LA(O)>, <&kp N2 >;
        mods = <(MOD_LSFT|MOD_RSFT)>;
        keep-mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    fslh_ru: fslh_ru {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp KP_DIVIDE>, <&kp N7 >;
        mods = <(MOD_LSFT|MOD_RSFT)>;
        keep-mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    ht: hold_tap {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        tapping-term-ms = <135>;
        quick-tap-ms = <0>;
        flavor = "tap-preferred";
        bindings = <&kp>, <&kp>;
    };

    mo_f20: mo_f20 {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        tapping-term-ms = < TAPPING_TERM >;
        retro-tap;
        flavor = "hold-preferred";
        bindings = <&f20>, <&kp>;
    };
};

keymap { compatible = "zmk,keymap";

ALPHA(COLEMAK, \
         Q, W, F, P, B,  J, L, U, Y, SQT, \
         A, R, S, T, G,  M, N, E, I, O, \
         Z, X, C, D, V,  K, H, comma, dot, FSLH)

ALPHA_RU(RULEMAK, \
         Q, W, F, P, B,  J, L, U, Y, SH, \
         A, R, S, T, G,  M, N, E, I, O, \
         X, Z, C, D, V,  K, H, comma, dot, SOFT)

qwerty { bindings = <
_____         &kp Q         hrlC(W)       hrlA(E)       hrlG(R)       &kp T              &kp Y           hrrG(U)          hrrA(I)         hrrC(O)         &kp P           _____
_____         hrlS(A)       &kp S         &kp D         &kp F         &kp G              &kp H           &kp J            &kp K           &kp L           hrrS(SEMI)      _____
_____         &kp Z         &kp X         &kp C         &kp V         &kp B              &kp N           &kp M            &kp COMMA       &kp DOT         &kp FSLH        _____
                                          &trans        &trans                 &trans                    &trans           &trans
>;};

extended { bindings = <
_____         &kp LS(N1)    hrlC(LS(N2))  hrlA(LS(N3))  hrlG(LS(N4))  &kp LS(N5)         &kp LS(N6)      hrrG(LS(N7))     hrrA(LS(N8))    hrrC(LS(N9))    &kp LS(N0)      _____
_____         hrlS(N1)      &kp N2        &kp N3        &kp N4        &kp N5             &kp N6          &kp N7           &kp N8          &kp N9          hrrS(N0)        _____
_____         &kp NUBS      &kp GRAVE     &kp FSLH      &kp EQUAL     &kp LS(EQUAL)      &kp LS(MINUS)   &kp MINUS        &kp BSLH        &kp LBKT        &kp RBKT        _____
                                          &trans        &trans               &kp JE_RU                   &trans           &trans
>;};

navigation { bindings = <
_____         &kp C_EJECT   &kp LCTRL     &kp LALT      &kp LGUI      _____              &kp PG_UP       &kp HOME         &kp UP          &kp END         &kp DEL         _____
_____         &kp LSHFT     _____         _____         _____         &kp K_APP          &kp PG_DN       &kp LEFT         &kp DOWN        &kp RIGHT       &kp BSPC        _____
_____         _____         _____         _____         _____         _____              &kp INS         &kp TAB          &kp LS(COMMA)   &kp LS(DOT)     &kp MINUS       _____
                                          &trans        &trans                 &trans                    &trans           &trans
>;};

function { bindings = <
_____         &kp LSHFT     &kp LCTRL     &kp LALT      &kp LGUI      &bootloader        _____           &kp LGUI         hrrA(F11)       hrrC(F12)       &kp LSHFT       _____
_____         hrlS(F1)      &kp F2        &kp F3        &kp F4        &kp F5             &kp F6          &kp F7           &kp F8          &kp F9          hrrS(F10)       _____
_____         &kp KP_NUM    &kp PSCRN     &kp SLCK      &kp PAUSE_BREAK &kp CAPS         _____           &kp C_PLAY_PAUSE &kp C_VOL_DN    &kp C_VOL_UP    &kp C_MUTE      _____
                                          &trans        &trans                 &trans                    &trans           &trans
>;};

mice { bindings = <
_____         &kp C_EJECT   &kp LCTL      &kp LALT      &kp LGUI      _____              &msc SCRL_DOWN  &msc SCRL_LEFT   &mmv MOVE_UP    &msc SCRL_RIGHT _____           _____
_____         &kp LSHFT     &mkp MB1      &mkp MB2      _____         _____              &msc SCRL_UP    &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_RIGHT &mkp MB3        _____
_____         _____         _____         _____         _____         _____              _____           _____            _____           _____           _____           _____
                                          _____         &mkp MB1              &mkp MB3   &mkp MB2        _____
>;};

};};
