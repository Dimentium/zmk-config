#include <behaviors.dtsi>
// #include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#include <dt-bindings/zmk/pointing.h>

// Keys
#define LEFT_HALF   0  1  2  3  4  5 12 13 14 15 16 17 24 25 26 27 28 29
#define RIGHT_HALF  6  7  8  9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define THUMBS     36 37 38 39 40

#define ___
#define __ &none

#define k0 
#define k1 0
#define k2 1
#define k3 2
#define k4 3
#define k5 4

#define k6 7
#define k7 8
#define k8 9
#define k9 10
#define k10 11
#define k11 

#define k12 
#define k13 12
#define k14 13
#define k15 14
#define k16 15
#define k17 16

#define k18 19
#define k19 20
#define k20 21
#define k21 22
#define k22 23
#define k23 

#define k24 
#define k25 26
#define k26 27
#define k27 28
#define k28 29
#define k29 30

#define k30 
#define k31 32
#define k32 33
#define k33 34
#define k34 35
#define k35

// Layers
#define ENG 0 // Alpha LAT 
#define RUL 1 // Alpha RUS
#define QWE 2 // QWERTY (static)
#define EXT 3 // Extended Symbols
#define NAV 4 // Navigation
#define FUN 5 // Function
#define MYS 6 // Mice

#define A_RU F
#define B_RU COMMA
#define C_RU W
#define D_RU L
#define E_RU T
#define F_RU A
#define G_RU U
#define H_RU LBKT
#define I_RU B
#define J_RU Q    // ij
#define K_RU R
#define L_RU K
#define M_RU V
#define N_RU Y
#define O_RU J
#define P_RU G
#define Q_RU DOT  // yu
#define R_RU H
#define S_RU C
#define T_RU N
#define U_RU E
#define V_RU SEMI // zh
#define W_RU D
#define X_RU Z    // ya
#define Y_RU S
#define Z_RU P

#define CH_RU   X
#define SH_RU   I
#define SQT_RU  I
#define SCH_RU  O
#define SOFT_RU M
#define FSLH_RU M
#define HARD_RU RBKT
#define JO_RU   GRAVE
#define JE_RU   SQT

#define COMMA_K_RU LS(FSLH)
#define SEMI_K_RU  LS(N4)
#define DOT_K_RU   FSLH
#define COLON_K_RU LS(N6)

// Bindings
#define _____ &none

#define TAPPING_TERM    500  // tapping-term-ms = <300>;
#define QUICK_TAP_TERM  250  // tapping-term-ms = <300>;
#define COMBO_TIMEOUT_2  50  // timeout-ms for 2 fingers cofbos
#define COMBO_TIMEOUT_3  80  // timeout-ms for 3 fingers combos

#define hrlG(key) &lgui_en 0 key
#define hrrG(KEY) &rgui_en 0 KEY
#define hrlC(KEY) &lctl_en 0 KEY
#define hrrC(KEY) &rctl_en 0 KEY
#define hrlS(key) &lshft 0 key
#define hrrS(key) &rshft 0 key
#define hrlA(KEY) &lalt_en 0 KEY
#define hrrA(KEY) &ralt_en 0 KEY

#define hrlG_RU(key) &lgui_ru 0 key // mods temporary toggled layer to ALPHA_LAT
#define hrrG_RU(KEY) &rgui_ru 0 KEY // mods temporary toggled layer to ALPHA_LAT
#define hrlC_RU(KEY) &lctl_ru 0 KEY // mods temporary toggled layer to ALPHA_LAT
#define hrrC_RU(KEY) &rctl_ru 0 KEY // mods temporary toggled layer to ALPHA_LAT
#define hrlA_RU(KEY) &lalt_ru 0 KEY // mods temporary toggled layer to ALPHA_LAT
#define hrrA_RU(KEY) &ralt_ru 0 KEY // mods temporary toggled layer to ALPHA_LAT

#define THUMBS_ROW _____ &lt NAV SPC &mo QWE &f20 _____

#define ALPHA_LAT(NAME, \
 T1, T2, T3, T4, T5, T6, T7, T8, T9, T10, \
 M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, \
 B1, B2, B3, B4, B5, B6, B7, B8, B9, B10) \
NAME { bindings = < \
___ &kp T1   hrlC(T2)     hrlA(T3)     hrlG(T4)     &kp T5   __ __   &kp T6  hrrG(T7)     hrrA(T8)     hrrC(T9)     &kp T10    ___ \
___ hrlS(M1) &mol EXT M2  &mol FUN M3  &mol MYS M4  &kp M5   __ __   &kp M6  &kp M7       &mor FUN M8  &mor EXT M9  hrrS(M10)  ___ \
___ &kp B1   &kp B2       &kp B3       &kp B4       &kp B5   __ __   &kp B6  &kp B7       &B8          &B9          &kp B10    ___ \
                                                           THUMBS_ROW \
>;};

#define ALPHA_RUS(NAME, \
 T1, T2, T3, T4, T5, T6, T7, T8, T9, T10, \
 M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, \
 B1, B2, B3, B4, B5, B6, B7, B8, B9, B10) \
NAME { bindings = < \
___ &kp T1##_RU   hrlC_RU(T2##_RU)  hrlA_RU(T3##_RU)  hrlG_RU(T4##_RU)  &kp T5##_RU   __ __   &kp T6##_RU  hrrG_RU(T7##_RU)  hrrA_RU(T8##_RU)  hrrC_RU(T9##_RU)  &kp T10##_RU    ___ \
___ hrlS(M1##_RU) &mol EXT M2##_RU  &mol FUN M3##_RU  &mol MYS M4##_RU  &kp M5##_RU   __ __   &kp M6##_RU  &kp M7##_RU       &mor FUN M8##_RU  &mor EXT M9##_RU  hrrS(M10##_RU)  ___ \
___ &kp B1##_RU   &kp B2##_RU       &kp B3##_RU       &kp B4##_RU       &kp B5##_RU   __ __   &kp B6##_RU  &kp B7##_RU       &B8##_RU          &B9##_RU          &kp B10##_RU    ___ \
                                                           THUMBS_ROW \
>;};

#define ALPHA(NAME, \
 T1, T2, T3, T4, T5, T6, T7, T8, T9, T10, \
 M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, \
 B1, B2, B3, B4, B5, B6, B7, B8, B9, B10) \
NAME { bindings = < \
___ &kp T1   hrlC(T2)     hrlA(T3)     hrlG(T4)     &kp T5   __ __   &kp T6  hrrG(T7)     hrrA(T8)     hrrC(T9)     &kp T10    ___ \
___ hrlS(M1) &mol EXT M2  &mol FUN M3  &mol MYS M4  &kp M5   __ __   &kp M6  &kp M7       &mor FUN M8  &mor EXT M9  hrrS(M10)  ___ \
___ &kp B1   &kp B2       &kp B3       &kp B4       &kp B5   __ __   &kp B6  &kp B7       &B8          &B9          &kp B10    ___ \
                                                           THUMBS_ROW \
>;}; \
NAME##_RU { bindings = < \
___ &kp T1##_RU   hrlC_RU(T2##_RU)  hrlA_RU(T3##_RU)  hrlG_RU(T4##_RU)  &kp T5##_RU   __ __   &kp T6##_RU  hrrG_RU(T7##_RU)  hrrA_RU(T8##_RU)  hrrC_RU(T9##_RU)  &kp T10##_RU    ___ \
___ hrlS(M1##_RU) &mol EXT M2##_RU  &mol FUN M3##_RU  &mol MYS M4##_RU  &kp M5##_RU   __ __   &kp M6##_RU  &kp M7##_RU       &mor FUN M8##_RU  &mor EXT M9##_RU  hrrS(M10##_RU)  ___ \
___ &kp B1##_RU   &kp B2##_RU       &kp B3##_RU       &kp B4##_RU       &kp B5##_RU   __ __   &kp B6##_RU  &kp B7##_RU       &B8##_RU          &B9##_RU          &kp B10##_RU    ___ \
                                                           THUMBS_ROW \
>;};
#define MOD_MACRO(name, mod)                            \
name: name##_macro {                                    \
    compatible = "zmk,behavior-macro";              \
    #binding-cells = <0>;                           \
    wait-ms = <0>;                                  \
    bindings                                            \
        = <&macro_press &kp mod>                        \
        , <&macro_pause_for_release>                    \
        , <&macro_release &kp mod>;                     \
 };
#define LAT_MOD_MACRO(name, mod, base_layer, mod_layer) \
name: name##_macro {                                    \
    compatible = "zmk,behavior-macro";              \
    #binding-cells = <0>;                           \
    wait-ms = <0>;                                  \
    bindings                                            \
        = <&macro_press &kp mod>                        \
        , <&macro_tap &to mod_layer>                    \
        , <&macro_pause_for_release>                    \
        , <&macro_tap &to base_layer>                   \
        , <&macro_release &kp mod>;                     \
 };
#define HOME_ROW_MOD_TAP_LEFT(name, macro, flavortype)  \
name: name##_mod_tap_lefthand {                         \
    compatible = "zmk,behavior-hold-tap";               \
    #binding-cells = <2>;                               \
    flavor = #flavortype;                               \
    tapping-term-ms = <TAPPING_TERM>;                   \
    quick-tap-ms = <QUICK_TAP_TERM>;                    \
    bindings = <macro>, <&kp>;                          \
    hold-trigger-key-positions = < RIGHT_HALF THUMBS >; \
};
#define HOME_ROW_MOD_TAP_RIGHT(name, macro, flavortype) \
name: name##_mod_tap_righthand {                        \
    compatible = "zmk,behavior-hold-tap";               \
    #binding-cells = <2>;                               \
    flavor = #flavortype;                               \
    tapping-term-ms = <TAPPING_TERM>;                   \
    quick-tap-ms = <QUICK_TAP_TERM>;                    \
    bindings = <macro>, <&kp>;                          \
    hold-trigger-key-positions = < LEFT_HALF THUMBS >;  \
};

&sk {
    release-after-ms = <1500>;
    quick-release;
};
&lt {
    tapping-term-ms = <500>;
    quick-tap-ms = <200>;
    flavor = "balanced";
 };
&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
    flavor = "balanced";
 };

/ {
combos { compatible = "zmk,combos";
    lock         { bindings = <&kp LC(LG(Q))>; key-positions = < k2 k3 k4 >; timeout-ms = < COMBO_TIMEOUT_3 >; };

    escape_left  { bindings = <&kp ESC>; key-positions = <k2 k3>; timeout-ms = < COMBO_TIMEOUT_2 >; };
    escape_left2 { bindings = <&kp ESC>; key-positions = <k2 k14>; timeout-ms = < COMBO_TIMEOUT_2 >; };
    escape_right { bindings = <&kp ESC>; key-positions = <k8 k9>; timeout-ms = < COMBO_TIMEOUT_2 >; };
    escape_right2{ bindings = <&kp ESC>; key-positions = <k9 k21>; timeout-ms = < COMBO_TIMEOUT_2 >; };

    enter_left   { bindings = <&kp ENTER>; key-positions = <k4 k16>; timeout-ms = < COMBO_TIMEOUT_2 >; };
    enter_right  { bindings = <&kp ENTER>; key-positions = <k32 k33>; timeout-ms = < COMBO_TIMEOUT_2 >; layers = <0 1 2 3> ;};
    enter_right2 { bindings = <&kp ENTER>; key-positions = <k7  k19>; timeout-ms = < COMBO_TIMEOUT_2 >; };

    bspc_left    { bindings = <&kp BACKSPACE>; key-positions = <k3 k16>; timeout-ms = < COMBO_TIMEOUT_2 >; };
    bspc_right   { bindings = <&kp BACKSPACE>; key-positions = <k8 k19>; timeout-ms = < COMBO_TIMEOUT_2 >; layers = <0 1 2 3> ;};
    
    del_left     { bindings = <&kp DELETE>; key-positions = <k3 k14>; timeout-ms = < COMBO_TIMEOUT_2 >; };
    del_right    { bindings = <&kp DELETE>; key-positions = <k8 k21>; timeout-ms = < COMBO_TIMEOUT_2 >; layers = <0 1 2 3> ;};

    tab_left     { bindings = <&kp TAB>; key-positions = <k3 k4>; timeout-ms = < COMBO_TIMEOUT_2 >; };
    tab_right    { bindings = <&kp TAB>; key-positions = <k7 k8>; timeout-ms = < COMBO_TIMEOUT_2 >; };
    tab_left_2   { bindings = <&kp TAB>; key-positions = <k3 k15>; timeout-ms = < COMBO_TIMEOUT_2 >; };
    tab_right_2  { bindings = <&kp TAB>; key-positions = <k8 k20>; timeout-ms = < COMBO_TIMEOUT_2 >; };

    copy_cut     { bindings = <&td_copy_cut>; key-positions = < k14 k16 >; timeout-ms = < COMBO_TIMEOUT_2 >; };
    paste        { bindings = <&kp LG(V)>; key-positions = < k2 k4 >; timeout-ms = < COMBO_TIMEOUT_2 >; };
    undo         { bindings = <&kp LG(Z)>; key-positions = < k13 k16 >; timeout-ms = < COMBO_TIMEOUT_2 >; };
    redo         { bindings = <&kp LS(LG(Z))>; key-positions = < k1 k4 >; timeout-ms = < COMBO_TIMEOUT_2 >; };

    to_rus       { bindings = <&rus>; key-positions = < k19 k20 k21 >; timeout-ms = < COMBO_TIMEOUT_3 >; };
    to_eng       { bindings = <&eng>; key-positions = < k14 k15 k16 >; timeout-ms = < COMBO_TIMEOUT_3 >; };

 };

macros {
    eng: eng { compatible = "zmk,behavior-macro";  #binding-cells = <0>; bindings = < &kp F18 &to 0 >; };
    rus: rus { compatible = "zmk,behavior-macro";  #binding-cells = <0>; bindings = < &kp F19 &to 1 >; };
    semi: semi { compatible = "zmk,behavior-macro"; tap-ms = <1>; wait-ms = <1>;  #binding-cells = <0>; bindings = < &kt_off LSHFT &kt_off RSHFT &kp SEMI >; };
    f20: f20 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
        bindings =
            <&macro_press &mo QWE &kp F20 >,
            <&macro_pause_for_release>,
            <&macro_release &kp F20 &mo QWE >;
        };
    MOD_MACRO(alt_en, LALT)
    MOD_MACRO(gui_en, LGUI)
    MOD_MACRO(ctl_en, LCTRL)
    MOD_MACRO(shft,  LSHFT)
    LAT_MOD_MACRO(alt_ru, LALT, 1, 0) // mods temporary toggled layer to ALPHA_LAT
    LAT_MOD_MACRO(gui_ru, LGUI, 1, 0) // mods temporary toggled layer to ALPHA_LAT
    LAT_MOD_MACRO(ctl_ru, LCTRL, 1, 0) // mods temporary toggled layer to ALPHA_LAT

};

behaviors {
    HOME_ROW_MOD_TAP_LEFT (lalt_en, &alt_en, balanced)
    HOME_ROW_MOD_TAP_LEFT (lgui_en, &gui_en, balanced)
    HOME_ROW_MOD_TAP_LEFT (lctl_en, &ctl_en, balanced)
    HOME_ROW_MOD_TAP_RIGHT(ralt_en, &alt_en, balanced)
    HOME_ROW_MOD_TAP_RIGHT(rgui_en, &gui_en, balanced)
    HOME_ROW_MOD_TAP_RIGHT(rctl_en, &ctl_en, balanced)

    HOME_ROW_MOD_TAP_LEFT (lalt_ru, &alt_ru, balanced) // mods temporary toggled layer to ALPHA_LAT
    HOME_ROW_MOD_TAP_LEFT (lgui_ru, &gui_ru, balanced) // mods temporary toggled layer to ALPHA_LAT
    HOME_ROW_MOD_TAP_LEFT (lctl_ru, &ctl_ru, balanced) // mods temporary toggled layer to ALPHA_LAT
    HOME_ROW_MOD_TAP_RIGHT(ralt_ru, &alt_ru, balanced) // mods temporary toggled layer to ALPHA_LAT
    HOME_ROW_MOD_TAP_RIGHT(rgui_ru, &gui_ru, balanced) // mods temporary toggled layer to ALPHA_LAT
    HOME_ROW_MOD_TAP_RIGHT(rctl_ru, &ctl_ru, balanced) // mods temporary toggled layer to ALPHA_LAT

    HOME_ROW_MOD_TAP_LEFT(lshft, &shft, balanced)
    HOME_ROW_MOD_TAP_RIGHT(rshft, &shft, balanced)

    mol: homerow_layers_left {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        tapping-term-ms = < TAPPING_TERM >;
        quick-tap-ms = < QUICK_TAP_TERM >;
        // flavor = "tap-preferred";
        flavor = "balanced";
        bindings = <&mo>, <&kp>;
        hold-trigger-key-positions = < RIGHT_HALF THUMBS >;    // <---[[right-hand keys]]
    };
    mor: homerow_layers_right {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        tapping-term-ms = < TAPPING_TERM >;
        quick-tap-ms = < QUICK_TAP_TERM >;
        // flavor = "tap-preferred";
        flavor = "balanced";
        bindings = <&mo>, <&kp>;
        hold-trigger-key-positions = < LEFT_HALF THUMBS >;    // <---[[left-hand keys]]
    };

    kt_off: key_toggle_on_only {
        compatible = "zmk,behavior-key-toggle";
        #binding-cells = <1>;
        display-name = "Key Toggle Off";
        toggle-mode = "off";
    };

    td_copy_cut: tap_dance_copy_cut {
        compatible = "zmk,behavior-tap-dance";
        #binding-cells = <0>;
        tapping-term-ms = <300>;
        bindings = <&kp LG(C)>, <&kp LG(X)>;
    };

    rt: rt {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "balanced";
        tapping-term-ms = < TAPPING_TERM >;
        quick-tap-ms = <200>;
        bindings = <&kp>, <&kp>;
        retro-tap;
    };

    comma: comma_semi {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp COMMA>, <&semi>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
        keep-mods = < 0 >;
    };
    dot: dot_colon {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp DOT>, <&kp COLON>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    qmark: qmark_excl {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp QMARK>, <&kp EXCL>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    comma_RU: comma_semi_ru {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp COMMA_K_RU>, <&kp SEMI_K_RU>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
        keep-mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    dot_RU: dot_colon_ru {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp DOT_K_RU>, <&kp COLON_K_RU>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
        keep-mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    semi_ru: semi_colon_ru {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp LS(N4)>, <&kp N6>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
        keep-mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    sqt_ru: sqt_ru {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp LA(O)>, <&kp N2 >;
        mods = <(MOD_LSFT|MOD_RSFT)>;
        keep-mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    fslh_ru: fslh_ru {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp KP_DIVIDE>, <&kp N7 >;
        mods = <(MOD_LSFT|MOD_RSFT)>;
        keep-mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    ht: hold_tap {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        tapping-term-ms = <135>;
        quick-tap-ms = <0>;
        flavor = "tap-preferred";
        bindings = <&kp>, <&kp>;
    };

    mo_f20: mo_f20 {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        tapping-term-ms = < TAPPING_TERM >;
        retro-tap;
        flavor = "hold-preferred";
        bindings = <&f20>, <&kp>;
    };
};

keymap { compatible = "zmk,keymap";

// ALPHA(COLEMAK, 
//      Q, W, F, P, B,  J, L, U, Y, SQT,
//      A, R, S, T, G,  M, N, E, I, O,
//      Z, X, C, D, V,  K, H, comma, dot, FSLH)

ALPHA_LAT(COLEMAK, 
     Q, W, F, P, B,  J, L, U, Y, SQT,
     A, R, S, T, G,  M, N, E, I, O,
     Z, X, C, D, V,  K, H, comma, dot, FSLH)

ALPHA_RUS(RULEMAK, 
     Q, F, W, P, B,  J, L, U, Y, SQT,
     A, R, S, T, G,  M, N, E, I, O,
     X, Z, C, D, V,  H, K, comma, dot, FSLH)

// ALPHA(SEMIMAK, 
//     F, L, H, V, Z,  SQT, W, U, O, Y,
//     S, R, N, T, K,    C, D, E, A, I,
//     X, J, B, M, Q,    P, G, comma, dot, FSLH)

// ALPHA(GRALMAK, 
//     B, L, D, W, Q,    J, F, O, U, SQT,
//     N, R, T, S, G,    Y, H, A, E, I,
//     Z, X, M, C, V,    K, P, comma, dot, FSLH)

// ALPHA_RUS(RULEMAK,
//      Q, W, F, P, B,  J, L, U, Y, SH,
//      A, R, S, T, G,  M, N, E, I, O,
//      X, Z, C, D, V,  K, H, comma, dot, SOFT)

qwerty { bindings = <
___         &kp Q         hrlC(W)       hrlA(E)       hrlG(R)       &kp T     __ __    &kp Y           hrrG(U)          hrrA(I)         hrrC(O)         &kp P           ___
___         hrlS(A)       &kp S         &kp D         &kp F         &kp G     __ __    &kp H           &kp J            &kp K           &kp L           hrrS(SEMI)      ___
___         &kp Z         &kp X         &kp C         &kp V         &kp B     __ __    &kp N           &kp M            &kp COMMA       &kp DOT         &kp FSLH        ___
                                          &trans        &trans                 &trans                    &trans           &trans
>;};

extended { bindings = <
___         &kp LS(N1)    hrlC(LS(N2))  hrlA(LS(N3))  hrlG(LS(N4))  &kp LS(N5) __ __   &kp LS(N6)      hrrG(LS(N7))     hrrA(LS(N8))    hrrC(LS(N9))    &kp LS(N0)      ___
___         hrlS(N1)      &kp N2        &kp N3        &kp N4        &kp N5     __ __   &kp N6          &kp N7           &kp N8          &kp N9          hrrS(N0)        ___
___         &kp NUBS      &kp GRAVE     &kp FSLH      &kp EQUAL     &kp LS(EQUAL) __ __ &kp LS(MINUS)   &kp MINUS        &kp BSLH        &kp LBKT        &kp RBKT        ___
                                          &trans        &trans                 &kp SQT                   &trans           &trans
>;};

navigation { bindings = <
___         &kp C_EJECT   &kp LCTRL     &kp LALT      &kp LGUI      _____     __ __    &kp PG_UP       &kp HOME         &kp UP          &kp END         &kp DEL         ___
___         &kp LSHFT     _____         _____         _____         &kp K_APP __ __    &kp PG_DN       &kp LEFT         &kp DOWN        &kp RIGHT       &kp BSPC        ___
___         _____         _____         _____         _____         _____     __ __    &kp INS         &kp TAB          &kp LS(COMMA)   &kp LS(DOT)     &kp MINUS       ___
                                          &trans        &trans                 &trans                    &trans           &trans
>;};

function { bindings = <
___         &kp LSHFT     &kp LCTRL     &kp LALT      &kp LGUI      &bootloader __ __  _____           &kp LGUI         hrrA(F11)       hrrC(F12)       &kp LSHFT       ___
